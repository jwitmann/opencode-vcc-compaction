{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "@madsoftwaredev/opencode-compaction-model@0.1.3"
    }
  ],
  // Same trigger as the VCC side so the fight is fair.
  // Summarizer: their default (opencode-go/deepseek-v4.1-flash#max).
  // Round 1 override (contributor as summarizer) proved incompatible
  // with their Go adapter — every compaction fell back to host-native.
  "compaction": { "buffer": "99%" }
}
